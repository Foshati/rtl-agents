{
  "publisher": "foshati",
  "name": "rtl-agents",
  "displayName": "RTL Agents",
  "version": "2.0.0",
  "packageManager": "pnpm@10.22.0",
  "description": "Professional RTL/LTR toggle support for AI Chats (Cursor, VS Code, Windsurf, VSCodium, Antigravity) with code block alignment safety.",
  "author": "Foshati",
  "license": "MIT",
  "homepage": "https://github.com/Foshati/rtl-agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/Foshati/rtl-agents"
  },
  "keywords": [
    "rtl",
    "ltr",
    "toggle",
    "bidi",
    "cursor",
    "antigravity",
    "windsurf",
    "persian",
    "arabic",
    "hebrew",
    "chat"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "public/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rtl-agents.add",
        "title": "RTL Agents: Activate RTL"
      },
      {
        "command": "rtl-agents.remove",
        "title": "RTL Agents: Deactivate RTL"
      },
      {
        "command": "rtl-agents.status",
        "title": "RTL Agents: Check Status"
      },
      {
        "command": "rtl-agents.restart",
        "title": "RTL Agents: Restart RTL"
      },
      {
        "command": "rtl-agents.toggle",
        "title": "RTL Agents: Toggle RTL/LTR"
      }
    ],
    "configuration": {
      "title": "RTL Agents",
      "properties": {
        "rtl-agents.customSelectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional chat container selectors to enable RTL inside. Text direction is resolved per paragraph within these containers."
        },
        "rtl-agents.rtlCharacterRegex": {
          "type": "string",
          "default": "",
          "description": "No longer used.",
          "deprecationMessage": "Deprecated since v2.0.0. Direction is now resolved natively per paragraph by the browser (unicode-bidi: plaintext), so no character regex is needed."
        }
      }
    },
    "keybindings": [
      {
        "command": "rtl-agents.toggle",
        "key": "ctrl+alt+r",
        "mac": "ctrl+cmd+r"
      }
    ]
  },
  "scripts": {
    "build": "tsup src/index.ts --external vscode",
    "lint": "eslint .",
    "vscode:prepublish": "pnpm build",
    "test": "esbuild test/run.ts --bundle --platform=node --format=cjs --outfile=.test-out/run.cjs --external:vscode --log-level=warning && node .test-out/run.cjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
